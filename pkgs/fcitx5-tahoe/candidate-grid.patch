+void WaylandInputWindow::startAnimation() {
+    if (!*parent_->config().tahoeAnimations) {
+        return;
+    }
+    animationStart_ = now(CLOCK_MONOTONIC);
+    animationTimer_->setNextInterval(16667);
+    animationTimer_->setOneShot();
+}
+
+void WaylandInputWindow::paintAnimated(cairo_t *cr, unsigned int width,
+                                     unsigned int height) {
+    if (!*parent_->config().tahoeAnimations || !animationStart_) {
+        paint(cr, width, height);
+        return;
+    }
+    const double progress = std::min(1.0,
+        (now(CLOCK_MONOTONIC) - animationStart_) / 140000.0);
+    const double ease = 1.0 - (1.0 - progress) * (1.0 - progress);
+    cairo_set_operator(cr, CAIRO_OPERATOR_CLEAR);
+    cairo_paint(cr);
+    cairo_set_operator(cr, CAIRO_OPERATOR_OVER);
+    cairo_push_group(cr);
+    paint(cr, width, height);
+    cairo_pop_group_to_source(cr);
+    cairo_paint_with_alpha(cr, 0.35 + 0.65 * ease);
+}
